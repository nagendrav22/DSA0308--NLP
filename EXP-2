def finite_automaton(string):
    state = 0

    for ch in string:
        if state == 0:
            if ch == 'a':
                state = 1
            else:
                state = 0

        elif state == 1:
            if ch == 'a':
                state = 1
            elif ch == 'b':
                state = 2
            else:
                state = 0

        elif state == 2:
            if ch == 'a':
                state = 1
            else:
                state = 0

    return state == 2

strings = ["ab", "aab", "abab", "abc", "abb", "hello"]

for string in strings:
    if finite_automaton(string):
        print(string, "-> Accepted")
    else:
        print(string, "-> Rejected")
